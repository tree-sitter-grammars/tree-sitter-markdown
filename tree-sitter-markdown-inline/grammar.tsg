// tree-sitter-markdown-inline grammar (native DSL).
// Mirrors tree-sitter-markdown-inline/grammar.js including the dynamic
// rules generated by add_inline_rules().

let c = import("../common/common.tsg")
let punctuation_suffix = optional(_last_token_punctuation)

grammar {
    language: "markdown_inline",
    flags: {
        enabled: ["EXTENSION_DEFAULT", "EXTENSION_GFM", "EXTENSION_TASK_LIST", "EXTENSION_STRIKETHROUGH", "EXTENSION_PIPE_TABLE", "EXTENSION_MINUS_METADATA", "EXTENSION_PLUS_METADATA", "EXTENSION_LATEX"],
        disabled: ["EXTENSION_TAGS", "EXTENSION_WIKI_LINK"],
    },
    externals: [
        _error,
        _trigger_error,
        _code_span_start,
        _code_span_close,
        _emphasis_open_star,
        _emphasis_open_underscore,
        _emphasis_close_star,
        _emphasis_close_underscore,
        _last_token_whitespace,
        _last_token_punctuation,
        _strikethrough_open,
        _strikethrough_close,
        _latex_span_start,
        _latex_span_close,
        _unclosed_span,
    ],
    precedences: [
        [_strong_emphasis_star_no_link, _inline_element_no_star_no_link],
        [_strong_emphasis_underscore_no_link, _inline_element_no_underscore_no_link],
        [hard_line_break, _whitespace],
        [hard_line_break, _text_base],
    ],
    conflicts: [
        [_closing_tag, _text_base],
        [_open_tag, _text_base],
        [_html_comment, _text_base],
        [_processing_instruction, _text_base],
        [_declaration, _text_base],
        [_cdata_section, _text_base],
        [_link_text_non_empty, _inline_element],
        [_link_text_non_empty, _inline_element_no_star],
        [_link_text_non_empty, _inline_element_no_underscore],
        [_link_text_non_empty, _inline_element_no_tilde],
        [_link_text, _inline_element],
        [_link_text, _inline_element_no_star],
        [_link_text, _inline_element_no_underscore],
        [_link_text, _inline_element_no_tilde],
        [_image_description, _image_description_non_empty, _text_base],
        [_image_shortcut_link, _image_description],
        [shortcut_link, _link_text],
        [link_destination, link_title],
        [_link_destination_parenthesis, link_title],
        #[cfg(EXTENSION_WIKI_LINK)] [wiki_link, _inline_element],
        #[cfg(EXTENSION_WIKI_LINK)] [wiki_link, _inline_element_no_star],
        #[cfg(EXTENSION_WIKI_LINK)] [wiki_link, _inline_element_no_underscore],
        #[cfg(EXTENSION_WIKI_LINK)] [wiki_link, _inline_element_no_tilde],
        [_emphasis_star, _inline_element],
        [_emphasis_star, _strong_emphasis_star, _inline_element],
        [_emphasis_underscore, _inline_element],
        [_emphasis_underscore, _strong_emphasis_underscore, _inline_element],
        #[cfg(EXTENSION_STRIKETHROUGH)] [_strikethrough, _inline_element],
        [_strong_emphasis_star, _inline_element_no_star],
        [_emphasis_underscore, _inline_element_no_star],
        [_emphasis_underscore, _strong_emphasis_underscore, _inline_element_no_star],
        #[cfg(EXTENSION_STRIKETHROUGH)] [_strikethrough, _inline_element_no_star],
        [_emphasis_star, _inline_element_no_underscore],
        [_emphasis_star, _strong_emphasis_star, _inline_element_no_underscore],
        [_strong_emphasis_underscore, _inline_element_no_underscore],
        #[cfg(EXTENSION_STRIKETHROUGH)] [_strikethrough, _inline_element_no_underscore],
        [_emphasis_star, _inline_element_no_tilde],
        [_emphasis_star, _strong_emphasis_star, _inline_element_no_tilde],
        [_emphasis_underscore, _inline_element_no_tilde],
        [_emphasis_underscore, _strong_emphasis_underscore, _inline_element_no_tilde],
        [_emphasis_star_no_link, _inline_element_no_link],
        [_emphasis_star_no_link, _strong_emphasis_star_no_link, _inline_element_no_link],
        [_emphasis_underscore_no_link, _inline_element_no_link],
        [_emphasis_underscore_no_link, _strong_emphasis_underscore_no_link, _inline_element_no_link],
        #[cfg(EXTENSION_STRIKETHROUGH)] [_strikethrough_no_link, _inline_element_no_link],
        [_strong_emphasis_star_no_link, _inline_element_no_star],
        [_emphasis_underscore_no_link, _inline_element_no_star_no_link],
        [_emphasis_underscore_no_link, _strong_emphasis_underscore_no_link, _inline_element_no_star_no_link],
        #[cfg(EXTENSION_STRIKETHROUGH)] [_strikethrough_no_link, _inline_element_no_star_no_link],
        [_emphasis_star_no_link, _inline_element_no_underscore_no_link],
        [_emphasis_star_no_link, _strong_emphasis_star_no_link, _inline_element_no_underscore_no_link],
        [_strong_emphasis_underscore_no_link, _inline_element_no_underscore],
        #[cfg(EXTENSION_STRIKETHROUGH)] [_strikethrough_no_link, _inline_element_no_underscore_no_link],
        [_emphasis_star_no_link, _inline_element_no_tilde_no_link],
        [_emphasis_star_no_link, _strong_emphasis_star_no_link, _inline_element_no_tilde_no_link],
        [_emphasis_underscore_no_link, _inline_element_no_tilde_no_link],
        [_emphasis_underscore_no_link, _strong_emphasis_underscore_no_link, _inline_element_no_tilde_no_link],
    ],
    extras: [],
}

// `_last_token_whitespace` is also referenced - needed from common/macros, but inline
// declares it as an external above.

rule inline { seq(optional(_last_token_whitespace), _inline) }

rule backslash_escape { _backslash_escape }
rule _backslash_escape { c::backslash_escape_pattern() }
rule entity_reference { c::entity_reference_pattern() }
rule numeric_character_reference { c::numeric_character_reference_pattern() }

// Rule wrappers for common helpers (parameterized by `_last_token_punctuation`).
rule link_label { c::link_label_(_text_inline_no_link, _soft_line_break) }
rule link_destination {
    c::link_destination_(punctuation_suffix, _word, _text_no_angle, _link_destination_parenthesis)
}
rule _link_destination_parenthesis {
    c::link_destination_parenthesis_(punctuation_suffix, _word, _link_destination_parenthesis)
}
rule _text_no_angle { c::text_no_angle_(punctuation_suffix, _word, _whitespace) }
rule link_title {
    c::link_title_(punctuation_suffix, _word, _whitespace, _soft_line_break, _trigger_error)
}
rule _newline_token { c::newline_token_pattern() }

rule code_span {
    seq(
        alias(_code_span_start, code_span_delimiter),
        repeat(choice(_text_base, "[", "]", _soft_line_break, _html_tag)),
        alias(_code_span_close, code_span_delimiter),
    )
}

rule latex_block {
    seq(
        alias(_latex_span_start, latex_span_delimiter),
        repeat(choice(_text_base, "[", "]", _soft_line_break, _html_tag, backslash_escape)),
        alias(_latex_span_close, latex_span_delimiter),
    )
}

// PRECEDENCE_LEVEL_LINK = 10. 2x = 20, 3x = 30. PRECEDENCE_LEVEL_HTML = 100.
rule _link_text {
    prec_dynamic(10, choice(_link_text_non_empty, seq("[", "]")))
}
rule _link_text_non_empty { seq("[", alias(_inline_no_link, link_text), "]") }
rule shortcut_link { prec_dynamic(10, _link_text_non_empty) }
rule full_reference_link { prec_dynamic(20, seq(_link_text, link_label)) }
rule collapsed_reference_link { prec_dynamic(10, seq(_link_text, "[", "]")) }
rule inline_link {
    prec_dynamic(10, seq(
        _link_text,
        "(",
        repeat(choice(_whitespace, _soft_line_break)),
        optional(seq(
            choice(
                seq(
                    link_destination,
                    optional(seq(
                        repeat1(choice(_whitespace, _soft_line_break)),
                        link_title,
                    )),
                ),
                link_title,
            ),
            repeat(choice(_whitespace, _soft_line_break)),
        )),
        ")",
    ))
}

#[cfg(EXTENSION_WIKI_LINK)]
rule wiki_link {
    prec_dynamic(20, seq(
        "[", "[",
        alias(_wiki_link_destination, link_destination),
        optional(seq("|", alias(_wiki_link_text, link_text))),
        "]", "]",
    ))
}
#[cfg(EXTENSION_WIKI_LINK)]
rule _wiki_link_destination {
    repeat1(choice(_word, c::punct_no_bracket_pipe(punctuation_suffix), _whitespace))
}
#[cfg(EXTENSION_WIKI_LINK)]
rule _wiki_link_text {
    repeat1(choice(_word, c::punct_no_bracket(punctuation_suffix), _whitespace))
}

rule image {
    choice(
        _image_inline_link, _image_shortcut_link,
        _image_full_reference_link, _image_collapsed_reference_link,
    )
}
rule _image_inline_link {
    prec_dynamic(10, seq(
        _image_description,
        "(",
        repeat(choice(_whitespace, _soft_line_break)),
        optional(seq(
            choice(
                seq(
                    link_destination,
                    optional(seq(
                        repeat1(choice(_whitespace, _soft_line_break)),
                        link_title,
                    )),
                ),
                link_title,
            ),
            repeat(choice(_whitespace, _soft_line_break)),
        )),
        ")",
    ))
}
rule _image_shortcut_link { prec_dynamic(30, _image_description_non_empty) }
rule _image_full_reference_link {
    prec_dynamic(10, seq(_image_description, link_label))
}
rule _image_collapsed_reference_link {
    prec_dynamic(10, seq(_image_description, "[", "]"))
}
rule _image_description {
    prec_dynamic(30, choice(_image_description_non_empty, seq("!", "[", prec(1, "]"))))
}
rule _image_description_non_empty {
    seq("!", "[", alias(_inline, image_description), prec(1, "]"))
}

rule uri_autolink {
    regexp(r"<[a-zA-Z][a-zA-Z0-9+\.\-][a-zA-Z0-9+\.\-]*:[^ \t\r\n<>]*>")
}
rule email_autolink {
    regexp(r"<[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*>")
}

rule _html_tag {
    choice(_open_tag, _closing_tag, _html_comment, _processing_instruction, _declaration, _cdata_section)
}
rule _open_tag {
    prec_dynamic(100, seq("<", _tag_name, repeat(_attribute), repeat(choice(_whitespace, _soft_line_break)), optional("/"), ">"))
}
rule _closing_tag {
    prec_dynamic(100, seq("<", "/", _tag_name, repeat(choice(_whitespace, _soft_line_break)), ">"))
}
rule _tag_name { seq(_word_no_digit, repeat(choice(_word_no_digit, _digits, "-"))) }
rule _attribute {
    seq(
        repeat1(choice(_whitespace, _soft_line_break)),
        _attribute_name,
        repeat(choice(_whitespace, _soft_line_break)),
        "=",
        repeat(choice(_whitespace, _soft_line_break)),
        _attribute_value,
    )
}
rule _attribute_name { regexp(r"[a-zA-Z_:][a-zA-Z0-9_\.:\-]*") }
rule _attribute_value {
    choice(
        regexp(r##"[^ \t\r\n"'=<>`]+"##),
        seq("'", repeat(choice(_word, _whitespace, _soft_line_break, c::punct_no_squote(punctuation_suffix))), "'"),
        seq("\"", repeat(choice(_word, _whitespace, _soft_line_break, c::punct_no_dquote(punctuation_suffix))), "\""),
    )
}
rule _html_comment {
    prec_dynamic(100, seq(
        "<!--",
        optional(seq(
            choice(
                _word,
                _whitespace,
                _soft_line_break,
                c::punct_no_dash_gt(punctuation_suffix),
                seq("-", c::punct_no_gt(punctuation_suffix)),
            ),
            repeat(prec_right(0, choice(
                _word,
                _whitespace,
                _soft_line_break,
                c::punct_no_dash(punctuation_suffix),
                seq("-", choice(_word, _whitespace, _soft_line_break, c::punct_no_dash(punctuation_suffix))),
            ))),
        )),
        "-->",
    ))
}
rule _processing_instruction {
    prec_dynamic(100, seq(
        "<?",
        repeat(prec_right(0, choice(_word, _whitespace, _soft_line_break, c::punct_no_none(punctuation_suffix)))),
        "?>",
    ))
}
rule _declaration {
    prec_dynamic(100, seq(
        regexp(r"<![A-Z]+"),
        choice(_whitespace, _soft_line_break),
        repeat(prec_right(0, choice(_word, _whitespace, _soft_line_break, c::punct_no_gt(punctuation_suffix)))),
        ">",
    ))
}
rule _cdata_section {
    prec_dynamic(100, seq(
        "<![CDATA[",
        repeat(prec_right(0, choice(_word, _whitespace, _soft_line_break, c::punct_no_none(punctuation_suffix)))),
        "]]>",
    ))
}

rule hard_line_break { seq(choice("\\", _whitespace_ge_2), _soft_line_break) }
rule _text {
    choice(_word, c::punct_no_none(punctuation_suffix), _whitespace)
}
rule _whitespace_ge_2 { regexp(r"\t| [ \t]+") }
rule _whitespace {
    seq(choice(_whitespace_ge_2, regexp(r" ")), optional(_last_token_whitespace))
}
rule _word { choice(_word_no_digit, _digits) }
rule _word_no_digit {
    regexp(r"[^!-/:-@\[-`\{-~ \t\n\r0-9]+(_+[^!-/:-@\[-`\{-~ \t\n\r0-9]+)*")
}
rule _digits { regexp(r"[0-9][0-9_]*") }
rule _soft_line_break { seq(_newline_token, optional(_last_token_whitespace)) }

// _inline_base. EXTENSION_LATEX adds latex_block; EXTENSION_TAGS adds tag.
rule _inline_base {
    prec_right(0, repeat1(choice(
        image,
        _soft_line_break,
        backslash_escape,
        hard_line_break,
        uri_autolink,
        email_autolink,
        entity_reference,
        numeric_character_reference,
        #[cfg(EXTENSION_LATEX)] latex_block,
        code_span,
        alias(_html_tag, html_tag),
        _text_base,
        #[cfg(EXTENSION_TAGS)] tag,
        _unclosed_span,
    )))
}
rule _text_base {
    choice(
        _word,
        c::punct_no_bracket(punctuation_suffix),
        _whitespace,
        "<!--",
        regexp(r"<![A-Z]+"),
        "<?",
        "<![CDATA[",
    )
}
rule _text_inline_no_link {
    choice(_text_base, _emphasis_open_star, _emphasis_open_underscore, _unclosed_span)
}

#[cfg(EXTENSION_TAGS)]
rule tag { regexp(r"#[0-9]*[a-zA-Z_\-/][a-zA-Z_\-/0-9]*") }

// =================================================================
// Generated by add_inline_rules() in JS. Each (link, delimiter) combo
// produces an _inline_element + suffix and _inline + suffix rule.
// =================================================================
rule _inline_element {
    choice(
        _inline_base,
        alias(_emphasis_star, emphasis),
        alias(_strong_emphasis_star, strong_emphasis),
        alias(_emphasis_underscore, emphasis),
        alias(_strong_emphasis_underscore, strong_emphasis),
        #[cfg(EXTENSION_STRIKETHROUGH)] alias(_strikethrough, strikethrough),
        _emphasis_open_star,
        _emphasis_open_underscore,
        _strikethrough_open,
        shortcut_link,
        full_reference_link,
        collapsed_reference_link,
        inline_link,
        seq(choice("[", "]"), optional(_last_token_punctuation)),
        #[cfg(EXTENSION_WIKI_LINK)] wiki_link,
    )
}
rule _inline { repeat1(_inline_element) }
rule _inline_element_no_star {
    choice(
        _inline_base,
        alias(_emphasis_star, emphasis),
        alias(_strong_emphasis_star, strong_emphasis),
        alias(_emphasis_underscore, emphasis),
        alias(_strong_emphasis_underscore, strong_emphasis),
        #[cfg(EXTENSION_STRIKETHROUGH)] alias(_strikethrough, strikethrough),
        _emphasis_open_underscore,
        _strikethrough_open,
        shortcut_link,
        full_reference_link,
        collapsed_reference_link,
        inline_link,
        seq(choice("[", "]"), optional(_last_token_punctuation)),
        #[cfg(EXTENSION_WIKI_LINK)] wiki_link,
    )
}
rule _inline_no_star { repeat1(_inline_element_no_star) }
rule _inline_element_no_underscore {
    choice(
        _inline_base,
        alias(_emphasis_star, emphasis),
        alias(_strong_emphasis_star, strong_emphasis),
        alias(_emphasis_underscore, emphasis),
        alias(_strong_emphasis_underscore, strong_emphasis),
        #[cfg(EXTENSION_STRIKETHROUGH)] alias(_strikethrough, strikethrough),
        _emphasis_open_star,
        _strikethrough_open,
        shortcut_link,
        full_reference_link,
        collapsed_reference_link,
        inline_link,
        seq(choice("[", "]"), optional(_last_token_punctuation)),
        #[cfg(EXTENSION_WIKI_LINK)] wiki_link,
    )
}
rule _inline_no_underscore { repeat1(_inline_element_no_underscore) }
rule _inline_element_no_tilde {
    choice(
        _inline_base,
        alias(_emphasis_star, emphasis),
        alias(_strong_emphasis_star, strong_emphasis),
        alias(_emphasis_underscore, emphasis),
        alias(_strong_emphasis_underscore, strong_emphasis),
        #[cfg(EXTENSION_STRIKETHROUGH)] alias(_strikethrough, strikethrough),
        _emphasis_open_star,
        _emphasis_open_underscore,
        shortcut_link,
        full_reference_link,
        collapsed_reference_link,
        inline_link,
        seq(choice("[", "]"), optional(_last_token_punctuation)),
        #[cfg(EXTENSION_WIKI_LINK)] wiki_link,
    )
}
rule _inline_no_tilde { repeat1(_inline_element_no_tilde) }
#[cfg(EXTENSION_STRIKETHROUGH)]
rule _strikethrough {
    prec_dynamic(1, seq(
        alias(_strikethrough_open, emphasis_delimiter),
        optional(_last_token_punctuation),
        _inline_no_tilde,
        alias(_strikethrough_close, emphasis_delimiter),
    ))
}
rule _emphasis_star {
    prec_dynamic(1, seq(
        alias(_emphasis_open_star, emphasis_delimiter),
        optional(_last_token_punctuation),
        _inline_no_star,
        alias(_emphasis_close_star, emphasis_delimiter),
    ))
}
rule _strong_emphasis_star {
    prec_dynamic(2, seq(
        alias(_emphasis_open_star, emphasis_delimiter),
        _emphasis_star,
        alias(_emphasis_close_star, emphasis_delimiter),
    ))
}
rule _emphasis_underscore {
    prec_dynamic(1, seq(
        alias(_emphasis_open_underscore, emphasis_delimiter),
        optional(_last_token_punctuation),
        _inline_no_underscore,
        alias(_emphasis_close_underscore, emphasis_delimiter),
    ))
}
rule _strong_emphasis_underscore {
    prec_dynamic(2, seq(
        alias(_emphasis_open_underscore, emphasis_delimiter),
        _emphasis_underscore,
        alias(_emphasis_close_underscore, emphasis_delimiter),
    ))
}
rule _inline_element_no_link {
    choice(
        _inline_base,
        alias(_emphasis_star_no_link, emphasis),
        alias(_strong_emphasis_star_no_link, strong_emphasis),
        alias(_emphasis_underscore_no_link, emphasis),
        alias(_strong_emphasis_underscore_no_link, strong_emphasis),
        #[cfg(EXTENSION_STRIKETHROUGH)] alias(_strikethrough_no_link, strikethrough),
        _emphasis_open_star,
        _emphasis_open_underscore,
        _strikethrough_open,
    )
}
rule _inline_no_link { repeat1(_inline_element_no_link) }
rule _inline_element_no_star_no_link {
    choice(
        _inline_base,
        alias(_emphasis_star_no_link, emphasis),
        alias(_strong_emphasis_star_no_link, strong_emphasis),
        alias(_emphasis_underscore_no_link, emphasis),
        alias(_strong_emphasis_underscore_no_link, strong_emphasis),
        #[cfg(EXTENSION_STRIKETHROUGH)] alias(_strikethrough_no_link, strikethrough),
        _emphasis_open_underscore,
        _strikethrough_open,
    )
}
rule _inline_no_star_no_link { repeat1(_inline_element_no_star_no_link) }
rule _inline_element_no_underscore_no_link {
    choice(
        _inline_base,
        alias(_emphasis_star_no_link, emphasis),
        alias(_strong_emphasis_star_no_link, strong_emphasis),
        alias(_emphasis_underscore_no_link, emphasis),
        alias(_strong_emphasis_underscore_no_link, strong_emphasis),
        #[cfg(EXTENSION_STRIKETHROUGH)] alias(_strikethrough_no_link, strikethrough),
        _emphasis_open_star,
        _strikethrough_open,
    )
}
rule _inline_no_underscore_no_link { repeat1(_inline_element_no_underscore_no_link) }
rule _inline_element_no_tilde_no_link {
    choice(
        _inline_base,
        alias(_emphasis_star_no_link, emphasis),
        alias(_strong_emphasis_star_no_link, strong_emphasis),
        alias(_emphasis_underscore_no_link, emphasis),
        alias(_strong_emphasis_underscore_no_link, strong_emphasis),
        #[cfg(EXTENSION_STRIKETHROUGH)] alias(_strikethrough_no_link, strikethrough),
        _emphasis_open_star,
        _emphasis_open_underscore,
    )
}
rule _inline_no_tilde_no_link { repeat1(_inline_element_no_tilde_no_link) }
#[cfg(EXTENSION_STRIKETHROUGH)]
rule _strikethrough_no_link {
    prec_dynamic(1, seq(
        alias(_strikethrough_open, emphasis_delimiter),
        optional(_last_token_punctuation),
        _inline_no_tilde_no_link,
        alias(_strikethrough_close, emphasis_delimiter),
    ))
}
rule _emphasis_star_no_link {
    prec_dynamic(1, seq(
        alias(_emphasis_open_star, emphasis_delimiter),
        optional(_last_token_punctuation),
        _inline_no_star_no_link,
        alias(_emphasis_close_star, emphasis_delimiter),
    ))
}
rule _strong_emphasis_star_no_link {
    prec_dynamic(2, seq(
        alias(_emphasis_open_star, emphasis_delimiter),
        _emphasis_star_no_link,
        alias(_emphasis_close_star, emphasis_delimiter),
    ))
}
rule _emphasis_underscore_no_link {
    prec_dynamic(1, seq(
        alias(_emphasis_open_underscore, emphasis_delimiter),
        optional(_last_token_punctuation),
        _inline_no_underscore_no_link,
        alias(_emphasis_close_underscore, emphasis_delimiter),
    ))
}
rule _strong_emphasis_underscore_no_link {
    prec_dynamic(2, seq(
        alias(_emphasis_open_underscore, emphasis_delimiter),
        _emphasis_underscore_no_link,
        alias(_emphasis_close_underscore, emphasis_delimiter),
    ))
}
